# Same-origin Bun gateway, behind HTTPS. Never expose the loopback port directly.
HIRING_DESK_UPSTREAM=https://engine.example/api/desk/market
# Supply a random server-only value of at least 32 bytes through protected service config.
CYBA_ENVELOPE_SECRET=
PORT=3001
NODE_ENV=production
# Secure is the default. Set to 0 only for local HTTP development.
CYBA_COOKIE_SECURE=1
